<Application x:Class="PasswordGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PasswordGenerator"
             xmlns:views="clr-namespace:PasswordGenerator.Views"
             xmlns:vms="clr-namespace:PasswordGenerator.ViewModels">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vms:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:GeneratorViewModel}">
            <views:GeneratorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:AnalyzerViewModel}">
            <views:AnalyzerView/>
        </DataTemplate>
    </Application.Resources>
</Application>
